<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Transaction Investigator (MVC)</title>
<link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
  <div class="wrap">
    <div class="title">
        <a asp-action="Index" asp-controller="Investigate" style="color:inherit; text-decoration:none;">Investigate</a>
        <span>/ MVC</span>
        <a asp-action="Index" asp-controller="FlowDefinition" style="float:right; font-size:12px; color:var(--accent);">Flow Definitions →</a>
    </div>
    @RenderBody()
  </div>
</body>
</html>
