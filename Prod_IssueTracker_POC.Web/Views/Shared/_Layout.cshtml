<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Production Issue Tracker</title>
<link rel="stylesheet" href="~/css/site.css" />
<style>
  .navbar {
    background-color: #2c3e50;
    padding: 0;
    margin: 0;
    border-bottom: 3px solid #3498db;
  }
  .navbar-content {
    display: flex;
    align-items: center;
    padding: 0 20px;
    height: 50px;
  }
  .navbar a {
    color: white;
    text-decoration: none;
    padding: 0 15px;
    height: 50px;
    display: flex;
    align-items: center;
    font-size: 14px;
    transition: background-color 0.3s;
  }
  .navbar a:hover {
    background-color: #34495e;
  }
  .navbar a.active {
    background-color: #3498db;
    font-weight: bold;
  }
  .navbar-title {
    font-size: 16px;
    font-weight: bold;
    margin-right: auto;
  }
</style>
</head>
<body>
  <nav class="navbar">
    <div class="navbar-content">
      <a asp-action="Index" asp-controller="Investigate" class="navbar-title">Production Issue Tracker</a>
      <a asp-action="Index" asp-controller="Investigate">Home</a>
      <a asp-action="Logs" asp-controller="Investigate">Logs</a>
      <a asp-action="Index" asp-controller="FlowDefinition">Flows</a>
      <a asp-action="Index" asp-controller="TagManagement">Tags</a>
      <a asp-action="Index" asp-controller="LokiConfig">Loki Config</a>
    </div>
  </nav>

  <div class="wrap">
    @RenderBody()
  </div>
</body>
</html>

