@model List<FlowDefinitionSummary>
@{
    ViewData["Title"] = "Flow Definitions";
}

<div style="margin-bottom: 32px;">
    <h1 style="margin: 0 0 8px; font-size: 24px; font-weight: 600;">Flow Definitions</h1>
    <p style="color: var(--text-dim); margin: 0; font-size: 13px;">Manage transaction flow definitions</p>
</div>

<div style="display: flex; gap: 8px; margin-bottom: 24px;">
    <a class="btn" style="display:inline-block; text-decoration:none;" asp-action="Create" asp-controller="FlowDefinition">+ Create Flow</a>
    <a class="mode-btn" style="display:inline-block; text-decoration:none;" asp-action="Index" asp-controller="Tag">🏷 Manage Tags</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty">No flow definitions yet — create one to get started.</div>
}
else
{
    <div class="attempts" style="flex-direction:column;">
        @foreach (var f in Model)
        {
            <a class="attempt-tab" asp-action="Edit" asp-controller="FlowDefinition" asp-route-flowName="@f.FlowName" style="margin-bottom:8px;">
                <div class="num">@f.FlowName</div>
                @if (!string.IsNullOrEmpty(f.Description))
                {
                    <div class="time">@f.Description</div>
                }
                <div class="status ok">@f.TagCount tag(s), @f.TransitionCount transition(s)</div>
            </a>
        }
    </div>
}

<div class="hint" style="margin-top:32px;">
    <a asp-action="Index" asp-controller="Investigate">← Back to Investigate</a>
</div>

