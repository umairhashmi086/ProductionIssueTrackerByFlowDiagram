@model FlowDefinitionDetailViewModel
@{
    ViewData["Title"] = Model.FlowName;
    var initialJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        flowDefinitionId = Model.Id,
        nodes = Model.Tags.Select(t => new { tagName = t.TagName, isTerminal = t.IsTerminal, x = t.PosX, y = t.PosY }),
        edges = Model.Transitions.Select(t => new { from = t.FromTagName, to = t.ToTagName }),
        availableTags = ViewBag.AvailableTags as List<string> ?? new List<string>()
    });
}

<div class="section-label" style="margin-top:0;">@Model.FlowName</div>
@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="hint">@Model.Description</p>
}

<div class="builder-toolbar">
    <button type="button" id="modeSelect" class="mode-btn active">Select / Drag</button>
    <button type="button" id="modeAdd" class="mode-btn">+ Add Tag</button>
    <button type="button" id="modeConnect" class="mode-btn">🔗 Connect</button>
    <button type="button" id="modeTerminal" class="mode-btn">⭐ Toggle Terminal</button>
    <button type="button" id="modeDelete" class="mode-btn">🗑 Delete</button>
    <span class="toolbar-gap"></span>
    <a href="@Url.Action("Index", "Tag")" class="mode-btn" style="text-decoration:none;">🏷 Manage Tags</a>
    <button type="button" id="saveBtn" class="save-btn">💾 Save</button>
    <span id="saveStatus" class="save-status"></span>
</div>
<div class="hint" id="modeHint">
    Click empty canvas to place a node in the current mode. Drag nodes to reposition (Select mode). Double-click a node's label to rename it.
</div>

<div class="builder-canvas-wrap">
    <svg id="builderSvg" width="1400" height="900">
        <defs>
            <marker id="b-arrow" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
                <path d="M0,0 L7,3 L0,6 Z" fill="#4f8cff" />
            </marker>
        </defs>
        <g id="edgesLayer"></g>
        <g id="nodesLayer"></g>
    </svg>
</div>

<div id="tagPickerOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); align-items:center; justify-content:center; z-index:100;">
    <div style="background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 20px; width: 360px; max-width: 90vw;">
        <div class="section-label" style="margin-top:0;">Add Tag</div>
        <div class="search-field" style="margin-bottom:12px;">
            <label for="tagPickerSelect">Pick an existing tag</label>
            <select id="tagPickerSelect" style="width:100%;">
                <option value="">— Select a tag —</option>
            </select>
        </div>
        <div class="hint" style="margin:4px 0 12px;">Not listed? Type a new tag name below — it'll be saved to the tag catalog for reuse next time.</div>
        <div class="search-field" style="margin-bottom:16px;">
            <label for="tagPickerNew">Or create a new tag</label>
            <input type="text" id="tagPickerNew" placeholder="e.g. PaymentInitiated" style="width:100%;" />
        </div>
        <div id="tagPickerError" class="hint" style="color: var(--danger); display:none;"></div>
        <div style="display:flex; gap:8px; justify-content:flex-end;">
            <button type="button" id="tagPickerCancel" class="mode-btn">Cancel</button>
            <button type="button" id="tagPickerConfirm" class="save-btn">Add</button>
        </div>
    </div>
</div>


<div class="hint" style="margin-top:16px;">
    <a asp-action="Index" asp-controller="FlowDefinition">← Back to Flow Definitions</a>
    &nbsp;·&nbsp;
    <a asp-action="Index" asp-controller="Investigate">Go to Investigate</a>
</div>

<script id="initialData" type="application/json">@Html.Raw(initialJson)</script>
<script>
(function () {
    const initial = JSON.parse(document.getElementById('initialData').textContent);
    let nodes = initial.nodes.map(n => ({ ...n }));
    let edges = initial.edges.map(e => ({ ...e }));
    let availableTags = (initial.availableTags || []).slice();
    const flowDefinitionId = initial.flowDefinitionId;

    const NODE_W = 150, NODE_H = 46;
    let mode = 'select';
    let connectFrom = null;
    let dragging = null; // { tagName, offsetX, offsetY }

    const svg = document.getElementById('builderSvg');
    const nodesLayer = document.getElementById('nodesLayer');
    const edgesLayer = document.getElementById('edgesLayer');
    const modeHint = document.getElementById('modeHint');

    const modeButtons = {
        select: document.getElementById('modeSelect'),
        add: document.getElementById('modeAdd'),
        connect: document.getElementById('modeConnect'),
        terminal: document.getElementById('modeTerminal'),
        delete: document.getElementById('modeDelete'),
    };
    const hints = {
        select: "Click empty canvas to place a node. Drag nodes to reposition. Double-click a node's label to rename it.",
        add: 'Click anywhere on the canvas to add a new tag there.',
        connect: 'Click a node to start a connection, then click another node to link them. Click the same node again to cancel.',
        terminal: 'Click a node to toggle whether it\u2019s a terminal (valid ending) state.',
        delete: 'Click a node to remove it (and its connections), or click a connecting line to remove just that link.',
    };

    function setMode(m) {
        mode = m;
        connectFrom = null;
        Object.entries(modeButtons).forEach(([key, btn]) => btn.classList.toggle('active', key === m));
        modeHint.textContent = hints[m];
        render();
    }
    Object.entries(modeButtons).forEach(([key, btn]) => btn.addEventListener('click', () => setMode(key)));

    function svgPoint(evt) {
        const rect = svg.getBoundingClientRect();
        return { x: evt.clientX - rect.left, y: evt.clientY - rect.top };
    }

    function findNode(tagName) { return nodes.find(n => n.tagName === tagName); }

    function labelLines(id) {
        return id.replace(/([a-z])([A-Z])/g, '$1\n$2').split('\n');
    }

    function render() {
        nodesLayer.innerHTML = '';
        edgesLayer.innerHTML = '';

        edges.forEach((e, idx) => {
            const from = findNode(e.from), to = findNode(e.to);
            if (!from || !to) return;
            const x1 = from.x + NODE_W / 2, y1 = from.y + NODE_H / 2;
            const x2 = to.x + NODE_W / 2, y2 = to.y + NODE_H / 2;

            // Wide invisible hit-path for easy clicking, plus the visible line.
            const hit = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            hit.setAttribute('x1', x1); hit.setAttribute('y1', y1);
            hit.setAttribute('x2', x2); hit.setAttribute('y2', y2);
            hit.setAttribute('stroke', 'transparent');
            hit.setAttribute('stroke-width', '14');
            hit.style.cursor = mode === 'delete' ? 'pointer' : 'default';
            hit.addEventListener('click', (evt) => { evt.stopPropagation(); onEdgeClick(idx); });
            edgesLayer.appendChild(hit);

            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', x1); line.setAttribute('y1', y1);
            line.setAttribute('x2', x2); line.setAttribute('y2', y2);
            line.setAttribute('stroke', '#4f8cff');
            line.setAttribute('stroke-width', '2');
            line.setAttribute('marker-end', 'url(#b-arrow)');
            line.style.pointerEvents = 'none';
            edgesLayer.appendChild(line);
        });

        nodes.forEach(n => {
            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.setAttribute('transform', `translate(${n.x},${n.y})`);
            g.style.cursor = mode === 'select' ? 'grab' : 'pointer';

            const isConnectSource = connectFrom === n.tagName;
            const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            rect.setAttribute('width', NODE_W);
            rect.setAttribute('height', NODE_H);
            rect.setAttribute('rx', 8);
            rect.setAttribute('fill', n.isTerminal ? '#12271c' : '#161a21');
            rect.setAttribute('stroke', isConnectSource ? '#f0a93a' : (n.isTerminal ? '#2ecc71' : '#4f8cff'));
            rect.setAttribute('stroke-width', isConnectSource ? '3' : (n.isTerminal ? '2.5' : '1.5'));
            if (n.isTerminal) rect.setAttribute('stroke-dasharray', '4,2');
            g.appendChild(rect);

            const lines = labelLines(n.tagName);
            const lineHeight = 13;
            const startY = NODE_H / 2 - ((lines.length - 1) * lineHeight) / 2 + 4;
            lines.forEach((line, li) => {
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', NODE_W / 2);
                text.setAttribute('y', startY + li * lineHeight);
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('font-family', 'SFMono-Regular,Consolas,monospace');
                text.setAttribute('font-size', '11');
                text.setAttribute('font-weight', '600');
                text.setAttribute('fill', n.isTerminal ? '#2ecc71' : '#e6e9ef');
                text.textContent = line;
                text.style.userSelect = 'none';
                g.appendChild(text);
            });

            g.addEventListener('mousedown', (evt) => onNodeMouseDown(evt, n));
            g.addEventListener('click', (evt) => { evt.stopPropagation(); onNodeClick(n); });
            g.addEventListener('dblclick', (evt) => { evt.stopPropagation(); onNodeRename(n); });

            nodesLayer.appendChild(g);
        });
    }

    function onNodeMouseDown(evt, node) {
        if (mode !== 'select') return;
        const pt = svgPoint(evt);
        dragging = { tagName: node.tagName, offsetX: pt.x - node.x, offsetY: pt.y - node.y };
    }

    svg.addEventListener('mousemove', (evt) => {
        if (!dragging) return;
        const node = findNode(dragging.tagName);
        if (!node) return;
        const pt = svgPoint(evt);
        // Round to whole pixels — coordinates from getBoundingClientRect()
        // are fractional, and the server's GraphNodeDto.X/Y are ints, so an
        // un-rounded value here would fail JSON model binding on Save.
        node.x = Math.round(Math.max(0, pt.x - dragging.offsetX));
        node.y = Math.round(Math.max(0, pt.y - dragging.offsetY));
        render();
    });
    svg.addEventListener('mouseup', () => { dragging = null; });
    svg.addEventListener('mouseleave', () => { dragging = null; });

    function onNodeClick(node) {
        if (mode === 'connect') {
            if (connectFrom === null) {
                connectFrom = node.tagName;
            } else if (connectFrom === node.tagName) {
                connectFrom = null; // cancel
            } else {
                const exists = edges.some(e => e.from === connectFrom && e.to === node.tagName);
                if (!exists) edges.push({ from: connectFrom, to: node.tagName });
                connectFrom = null;
            }
            render();
        } else if (mode === 'terminal') {
            node.isTerminal = !node.isTerminal;
            render();
        } else if (mode === 'delete') {
            nodes = nodes.filter(n => n.tagName !== node.tagName);
            edges = edges.filter(e => e.from !== node.tagName && e.to !== node.tagName);
            render();
        }
    }

    function onEdgeClick(index) {
        if (mode !== 'delete') return;
        edges.splice(index, 1);
        render();
    }

    function onNodeRename(node) {
        const newName = prompt('Rename tag', node.tagName);
        if (!newName || newName.trim() === '' || newName === node.tagName) return;
        const trimmed = newName.trim();
        if (nodes.some(n => n.tagName === trimmed)) { alert('A tag with that name already exists.'); return; }
        edges.forEach(e => {
            if (e.from === node.tagName) e.from = trimmed;
            if (e.to === node.tagName) e.to = trimmed;
        });
        node.tagName = trimmed;
        render();
    }

    svg.addEventListener('click', (evt) => {
        if (mode !== 'add') return;
        const pt = svgPoint(evt);
        openTagPicker(pt);
    });

    // --- Tag picker modal: pick an existing catalog tag, or type a new one
    // (which gets saved to the catalog so it's reusable next time) instead
    // of the old browser prompt() that made you retype tag names each time.
    const tagPickerOverlay = document.getElementById('tagPickerOverlay');
    const tagPickerSelect = document.getElementById('tagPickerSelect');
    const tagPickerNew = document.getElementById('tagPickerNew');
    const tagPickerError = document.getElementById('tagPickerError');
    const tagPickerCancel = document.getElementById('tagPickerCancel');
    const tagPickerConfirm = document.getElementById('tagPickerConfirm');
    let pendingPoint = null;

    function openTagPicker(pt) {
        pendingPoint = pt;
        tagPickerError.style.display = 'none';
        tagPickerNew.value = '';
        tagPickerSelect.innerHTML = '<option value="">— Select a tag —</option>';
        availableTags
            .filter(t => !nodes.some(n => n.tagName === t))
            .forEach(t => {
                const opt = document.createElement('option');
                opt.value = t; opt.textContent = t;
                tagPickerSelect.appendChild(opt);
            });
        tagPickerOverlay.style.display = 'flex';
        tagPickerSelect.focus();
    }

    function closeTagPicker() {
        tagPickerOverlay.style.display = 'none';
        pendingPoint = null;
    }

    tagPickerCancel.addEventListener('click', closeTagPicker);
    tagPickerOverlay.addEventListener('click', (evt) => { if (evt.target === tagPickerOverlay) closeTagPicker(); });
    tagPickerSelect.addEventListener('change', () => { if (tagPickerSelect.value) tagPickerNew.value = ''; });
    tagPickerNew.addEventListener('input', () => { if (tagPickerNew.value) tagPickerSelect.value = ''; });

    function addNodeAt(tagName, pt) {
        nodes.push({ tagName, isTerminal: false, x: Math.round(Math.max(0, pt.x - 75)), y: Math.round(Math.max(0, pt.y - 23)) });
        render();
    }

    tagPickerConfirm.addEventListener('click', async () => {
        const picked = tagPickerSelect.value;
        const typed = tagPickerNew.value.trim();
        const tagName = picked || typed;
        if (!tagName) { tagPickerError.textContent = 'Pick an existing tag or type a new one.'; tagPickerError.style.display = 'block'; return; }
        if (nodes.some(n => n.tagName === tagName)) { tagPickerError.textContent = 'A tag with that name already exists on this canvas.'; tagPickerError.style.display = 'block'; return; }

        if (typed && !picked) {
            // Brand-new tag name: save it to the catalog so it's reusable
            // in this and other flows next time, then place it.
            try {
                const res = await fetch('@Url.Action("CreateApi", "Tag")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TagName: tagName })
                });
                if (!res.ok) throw new Error('Request failed (' + res.status + ')');
                const data = await res.json();
                if (!availableTags.includes(data.tagName)) availableTags.push(data.tagName);
            } catch (err) {
                tagPickerError.textContent = 'Could not save new tag to catalog: ' + err.message;
                tagPickerError.style.display = 'block';
                return;
            }
        }

        const pt = pendingPoint;
        closeTagPicker();
        addNodeAt(tagName, pt);
    });

    document.getElementById('saveBtn').addEventListener('click', async () => {
        const statusEl = document.getElementById('saveStatus');
        statusEl.textContent = 'Saving…';
        statusEl.style.color = 'var(--text-faint)';
        try {
            const res = await fetch('@Url.Action("SaveGraph", "FlowDefinition")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    FlowDefinitionId: flowDefinitionId,
                    Nodes: nodes.map(n => ({ TagName: n.tagName, IsTerminal: n.isTerminal, X: Math.round(n.x), Y: Math.round(n.y) })),
                    Edges: edges.map(e => ({ From: e.from, To: e.to }))
                })
            });
            if (!res.ok) throw new Error('Request failed (' + res.status + ')');
            const data = await res.json();
            statusEl.textContent = `Saved — ${data.tagCount} tag(s), ${data.transitionCount} transition(s).`;
            statusEl.style.color = '#2ecc71';
        } catch (err) {
            statusEl.textContent = 'Save failed: ' + err.message;
            statusEl.style.color = '#ef5350';
        }
    });

    render();
})();
</script>
