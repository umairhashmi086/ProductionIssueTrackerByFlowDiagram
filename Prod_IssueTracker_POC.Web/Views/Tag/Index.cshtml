@model List<TagRow>
@{
    ViewData["Title"] = "Manage Tags";
}

<div style="margin-bottom: 32px;">
    <h1 style="margin: 0 0 8px; font-size: 24px; font-weight: 600;">Tag Catalog</h1>
    <p style="color: var(--text-dim); margin: 0; font-size: 13px;">Manage reusable transaction state tags</p>
</div>

<form asp-action="Create" asp-controller="Tag" method="post" class="search-form" style="margin-bottom:20px;">
    @Html.AntiForgeryToken()
    <div class="search-field">
        <label for="TagName">Tag Name</label>
        <input type="text" id="TagName" name="TagName" placeholder="e.g. PaymentInitiated" required />
    </div>
    <button type="submit" style="margin-top: 24px;">+ Add Tag</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="health-banner bad" style="margin-bottom:16px;">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

@if (Model.Count == 0)
{
    <div class="empty">No tags yet — add one to get started.</div>
}
else
{
    <div class="attempts" style="flex-direction:column;">
        @foreach (var t in Model)
        {
            <div class="attempt-tab" style="display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <div class="num">@t.TagName</div>
                </div>
                <form asp-action="Delete" asp-controller="Tag" asp-route-id="@t.Id" method="post"
                      onsubmit="return confirm('Remove &quot;@t.TagName&quot;?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="linklike" style="color: var(--danger);">Remove</button>
                </form>
            </div>
        }
    </div>
}

<div class="hint" style="margin-top:32px;">
    <a asp-action="Index" asp-controller="FlowDefinition">← Back to Flow Definitions</a>
</div>

