@model List<TagRow>
@{
    ViewData["Title"] = "Manage Tags";
}

<div class="section-label" style="margin-top:0;">Manage Tags</div>
<p class="hint" style="margin-bottom:16px;">
    This is the reusable catalog of tag names. Add a tag once here and it becomes pickable
    in every flow's "+ Add Tag" mode — no more retyping the same tag name from scratch each time.
</p>

<form asp-action="Create" asp-controller="Tag" method="post" class="search-form" style="margin-bottom:20px;">
    @Html.AntiForgeryToken()
    <div class="search-field">
        <label for="TagName">New tag name</label>
        <input type="text" id="TagName" name="TagName" placeholder="e.g. PaymentInitiated" required />
    </div>
    <button type="submit">+ Add Tag</button>
</form>
@if (!ViewData.ModelState.IsValid)
{
    <div class="health-banner bad" style="margin-bottom:16px;">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

@if (Model.Count == 0)
{
    <div class="empty">No tags yet — add one above.</div>
}
else
{
    <div class="attempts" style="flex-direction:column;">
        @foreach (var t in Model)
        {
            <div class="attempt-tab" style="display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <div class="num">@t.TagName</div>
                    <div class="time">Added @t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <form asp-action="Delete" asp-controller="Tag" asp-route-id="@t.Id" method="post"
                      onsubmit="return confirm('Remove &quot;@t.TagName&quot; from the tag catalog? Flows that already use it are unaffected.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="linklike" style="color: var(--danger);">Remove</button>
                </form>
            </div>
        }
    </div>
}

<div class="hint" style="margin-top:24px;">
    <a asp-action="Index" asp-controller="FlowDefinition">← Back to Flow Definitions</a>
</div>
