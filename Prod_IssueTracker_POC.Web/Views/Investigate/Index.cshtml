@model SearchIndexViewModel
@{
    ViewData["Title"] = "Investigate";
}

<div style="margin-bottom: 32px;">
    <h1 style="margin: 0 0 8px; font-size: 24px; font-weight: 600;">Investigate Transactions</h1>
    <p style="color: var(--text-dim); margin: 0; font-size: 13px;">Search for transaction attempts by Reference Number or Kong ID</p>
</div>

<form asp-action="Reference" asp-controller="Investigate" method="get" class="search-form" target="_blank">
    <div class="search-field">
        <label for="flowNameSelect">Flow</label>
        <select id="flowNameSelect" name="flowName">
            <option value="All">All Flows</option>
            @foreach (var flow in Model.FlowNames)
            {
                <option value="@flow">@flow</option>
            }
        </select>
    </div>

    <div class="search-field">
        <label for="referenceNumberInput">Reference Number</label>
        <input id="referenceNumberInput" type="text" name="referenceNumber" placeholder="e.g. MG-2026-00417" />
    </div>

    <div class="search-field">
        <label for="kongIdInput">Or Kong ID</label>
        <input id="kongIdInput" type="text" name="kongId" placeholder="Correlation ID" />
    </div>

    <button type="submit" style="margin-top: 24px;">Search</button>
</form>

<div class="hint" style="margin-top: 16px; max-width: 600px;">
    Enter either a Reference Number (to see all attempts) or Kong ID (for a specific request). Optionally filter by Flow type.
</div>

