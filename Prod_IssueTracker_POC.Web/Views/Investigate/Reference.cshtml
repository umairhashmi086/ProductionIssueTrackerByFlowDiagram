@model ReferenceViewModel
@{
    ViewData["Title"] = Model.ReferenceNumber;
    var active = Model.ActiveAttempt;
}

<div class="search-row">
    <form asp-action="Reference" asp-controller="Investigate" method="get" style="display:flex; gap:8px; flex:1;">
        <input type="hidden" name="flowName" value="@Model.FlowName" />
        <input type="text" name="referenceNumber" value="@Model.ReferenceNumber" />
        <button type="submit">Investigate</button>
    </form>
</div>

<div class="meta-line">@Model.Attempts.Count attempt@(Model.Attempts.Count == 1 ? "" : "s") found for @Model.ReferenceNumber — flow: @Model.FlowName</div>

<div class="attempts">
    @for (int i = 0; i < Model.Attempts.Count; i++)
    {
        var a = Model.Attempts[i];
        var hasFlowDiagram = Model.Diagram.Nodes.Count > 0;
        var cls = hasFlowDiagram ? (a.IsHealthy ? "ok" : "bad") : "neutral";
        var statusText = !hasFlowDiagram
            ? "No flow configured"
            : (a.IsHealthy
                ? $"Reached {a.LastValidTag}"
                : (a.HasDeviations ? $"{a.DeviationCount} unexpected tag(s)" : $"Stuck at {a.LastValidTag}"));
        var activeCls = i == Model.ActiveAttemptIndex ? "active" : "";
        <a class="attempt-tab @cls @activeCls"
           asp-action="Reference" asp-controller="Investigate"
           asp-route-referenceNumber="@Model.ReferenceNumber" asp-route-flowName="@Model.FlowName" asp-route-attemptIndex="@i">
            <div class="num">Attempt @a.AttemptNumber</div>
            <div class="time">@a.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
            <div class="status @cls">@statusText</div>
            <div class="kong-id-line">Kong ID: @a.KongId</div>
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(active.CrossAttemptLink))
{
    <div class="link-banner"><b>Cross-attempt link —</b> @active.CrossAttemptLink</div>
}

@if (Model.Diagram.Nodes.Count > 0)
{
    @if (active.IsHealthy)
    {
        <div class="health-banner ok">Healthy — reached terminal state @active.LastValidTag.</div>
    }
    else
    {
        <div class="health-banner bad">
            @if (active.HasDeviations)
            {
                <span>Deviation — @active.DeviationCount unexpected tag(s) found (highlighted red below).</span>
            }
            @if (active.DeadEnd)
            {
                <span>@(active.HasDeviations ? " Also, the" : "The") flow stopped at <b>@active.LastValidTag</b> without reaching a terminal state.</span>
            }
        </div>
    }
}

@if (Model.Diagram.Nodes.Count == 0)
{
    <div class="no-diagram-banner">
        ⓘ No flow diagram configured for <strong>@Model.FlowName</strong> — showing raw tag sequence only. Tags are not marked as expected or unexpected.
    </div>
}
else
{
    <div class="diagram-panel">
        <h3>Flow Diagram</h3>
        @Html.Raw(Model.Diagram.SvgMarkup)
        <div class="diagram-legend">
            <span><span class="legend-dot" style="background:#2ecc71"></span> reached</span>
            <span><span class="legend-dot" style="background:#ef5350"></span> dead end</span>
            <span><span class="legend-dot" style="background:#3a4150"></span> not reached</span>
            <span>🔴 unexpected tag followed — see raw sequence below</span>
        </div>
    </div>
}

<a class="btn" style="display:inline-block; text-decoration:none; margin-bottom:16px;"
   asp-action="DownloadReport" asp-controller="Investigate"
   asp-route-referenceNumber="@Model.ReferenceNumber" asp-route-flowName="@Model.FlowName" asp-route-attemptIndex="@Model.ActiveAttemptIndex"
   target="_blank">
    ⬇ Download Report (diagram + raw sequence)
</a>

<div class="section-label">Raw Tag Sequence</div>
<div style="display: table; width: 100%; border-collapse: collapse; font-family: monospace; font-size: 13px;">
    @{
        string? previousService = null;
        long blockLatency = 0;
    }
    @for (int i = 0; i < active.TagSequence.Count; i++)
    {
        var tag = active.TagSequence[i];
        var currentService = string.IsNullOrWhiteSpace(tag.ServiceName) ? "Unknown" : tag.ServiceName;
        var serviceChanged = currentService != previousService;

        // Calculate latency for this block (consecutive tags from same service)
        if (serviceChanged)
        {
            blockLatency = 0;
            // Sum latencies for all consecutive tags with same service
            for (int j = i; j < active.TagSequence.Count; j++)
            {
                var nextTag = active.TagSequence[j];
                var nextService = string.IsNullOrWhiteSpace(nextTag.ServiceName) ? "Unknown" : nextTag.ServiceName;
                if (nextService == currentService)
                {
                    blockLatency += nextTag.LatencyMs;
                }
                else
                {
                    break;
                }
            }
        }

        <div style="display: table-row;">
            <!-- Service Column - show only when service changes -->
            @if (serviceChanged)
            {
                <div style="display: table-cell; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border); background: var(--panel-2); font-weight: 600; color: #3b82f6; min-width: 120px;">
                    @currentService<br/>
                    <span style="font-size: 11px; font-weight: normal; color: var(--text-faint);">+@(blockLatency)ms</span>
                </div>
                previousService = currentService;
            }
            else
            {
                <div style="display: table-cell; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border); background: var(--panel-2);"></div>
            }

            <!-- Tags Column -->
            <div style="display: table-cell; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border);">
                <span style="color: var(--ok); font-weight: 500;">✓</span>
                <span style="margin-left: 8px;">@tag.TagName</span>
                <span style="margin-left: 16px; color: var(--text-faint);">
                    @if (i == 0)
                    {
                        <span>start</span>
                    }
                    else
                    {
                        <span>+@(tag.LatencyMs)ms</span>
                    }
                </span>
                @if (!string.IsNullOrEmpty(tag.MetadataJson))
                {
                    <div style="margin-top: 4px; color: var(--text-faint); font-size: 11px;">@tag.MetadataJson</div>
                }
            </div>
        </div>
    }
</div>
