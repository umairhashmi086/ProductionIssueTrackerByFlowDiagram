@model ReferenceViewModel
@{
    Layout = null;
    var active = Model.ActiveAttempt;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Investigation Report — @Model.ReferenceNumber</title>
<style>
  :root {
    --bg: #0f1115; --panel: #161a21; --panel-2: #1c212a; --border: #262c37;
    --text: #e6e9ef; --text-dim: #9aa3b2; --text-faint: #5c6577;
    --ok: #2ecc71; --ok-bg: #12271c; --danger: #ef5350; --danger-bg: #2b1414;
    --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; padding: 32px; }
  .wrap { max-width: 900px; margin: 0 auto; }
  h1 { font-size: 18px; margin: 0 0 4px; }
  .subtitle { color: var(--text-faint); font-size: 12px; margin-bottom: 24px; }
  .meta-line { color: var(--text-faint); font-size: 12px; margin-bottom: 16px; font-family: var(--mono); }
  .health-banner { border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px; }
  .health-banner.ok { background: var(--ok-bg); color: var(--ok); border: 1px solid var(--ok); }
  .health-banner.bad { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger); }
  .diagram-panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 24px; }
  .section-label { font-size: 12px; font-weight: 600; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.04em; margin: 24px 0 10px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-faint); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; }
  td.tag-name { font-family: var(--mono); font-weight: 600; }
  td.tag-name.bad { color: var(--danger); }
  td.tag-time { font-family: var(--mono); color: var(--text-faint); white-space: nowrap; }
  td.tag-meta { font-family: var(--mono); color: var(--text-dim); font-size: 12px; }
  .footer-note { color: var(--text-faint); font-size: 11px; margin-top: 24px; }
</style>
</head>
<body>
  <div class="wrap">
    <h1>Investigation Report — @Model.ReferenceNumber</h1>
    <div class="subtitle">Flow: @Model.FlowName &nbsp;·&nbsp; Attempt @active.AttemptNumber of @Model.Attempts.Count &nbsp;·&nbsp; Kong ID: @active.KongId</div>
    <div class="meta-line">Generated @DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>

    @if (active.IsHealthy)
    {
        <div class="health-banner ok">Healthy — reached terminal state @active.LastValidTag.</div>
    }
    else
    {
        <div class="health-banner bad">
            @if (active.HasDeviations)
            {
                <span>Deviation — @active.DeviationCount unexpected tag(s) found (highlighted red below).</span>
            }
            @if (active.DeadEnd)
            {
                <span>@(active.HasDeviations ? " Also, the" : "The") flow stopped at <b>@active.LastValidTag</b> without reaching a terminal state.</span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(active.CrossAttemptLink))
    {
        <div class="health-banner bad">@active.CrossAttemptLink</div>
    }

    <div class="diagram-panel">
        @Html.Raw(Model.Diagram.SvgMarkup)
    </div>

    <div class="section-label">Raw Tag Sequence</div>
    <table>
        <thead>
            <tr><th>#</th><th>Tag</th><th>Service</th><th>Timestamp</th><th>Latency</th><th>Metadata</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < active.TagSequence.Count; i++)
            {
                var t = active.TagSequence[i];
                var isLast = i == active.TagSequence.Count - 1;
                var isBad = t.IsUnexpected || (isLast && active.DeadEnd);
                <tr>
                    <td>@(i + 1)</td>
                    <td class="tag-name @(isBad ? "bad" : "")">@t.TagName@(isBad && isLast && active.DeadEnd ? " (dead end)" : "")@(t.IsUnexpected && !(isLast && active.DeadEnd) ? " (unexpected)" : "")</td>
                    <td class="tag-time">@(string.IsNullOrWhiteSpace(t.ServiceName) ? "-" : t.ServiceName)</td>
                    <td class="tag-time">@t.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="tag-time">@(i == 0 ? "start" : $"+{t.LatencyMs}ms")</td>
                    <td class="tag-meta">@t.MetadataJson</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer-note">Generated by the Production Issue Investigator. This file is self-contained — the diagram is inline SVG, no external images or network calls needed to view it.</div>
  </div>
</body>
</html>
