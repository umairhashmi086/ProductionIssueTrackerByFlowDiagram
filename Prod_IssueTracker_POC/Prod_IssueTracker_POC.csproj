    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>99e1952f-9fc7-489f-a2ef-9fa3f1b54059</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
